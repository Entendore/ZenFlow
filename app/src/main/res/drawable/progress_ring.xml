<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:innerRadius="120dp" android:shape="ring" android:thickness="10dp"
            android:useLevel="false">
            <solid android:color="#33A5A6F6" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="270" android:toDegrees="630">
            <shape android:innerRadius="120dp" android:shape="ring" android:thickness="10dp"
                android:useLevel="true">
                <solid android:color="@color/lavender" />
            </shape>
        </rotate>
    </item>
</layer-list>
